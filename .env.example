PORT=5000
NODE_ENV=development

FRONTEND_URL=http://localhost:5173

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=emnel-media
# Raw Postgres connection string from Supabase Project Settings → Database.
# Used only by `npm run db:pipeline` to apply schema, migrations, and seed SQL.
SUPABASE_DB_URL=

JWT_SECRET=change-this-to-a-long-random-string-min-16-chars
JWT_EXPIRES_IN=7d

ANTHROPIC_API_KEY=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# Email (transactional: trip-portal magic links + new-booking notifications).
# Choose ONE provider. Leave both blank to disable email (sends are skipped).
#   Option A — Resend (recommended): set the API key only.
#   Option B — SMTP (your domain mailbox): set SMTP_HOST (+ the rest).
# EMAIL_FROM must be a sender you've verified with your provider/domain.
EMAIL_FROM="Emnel Adventures <noreply@emneladventures.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Inbox that receives new-booking notifications (blank = skip).
SPECIALIST_EMAIL=

# GA4 Data API (analytics traffic) — service account, backend only. Leave blank
# to run without GA4 (dashboard shows a "not configured" state). Keep the private
# key as one line with literal \n for newlines, wrapped in quotes.
GA4_PROPERTY_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Delete analytics_events older than this many days (nightly job). Default 180.
ANALYTICS_RETENTION_DAYS=180

# ── Emnel AI Safari Advisor (v2) ──────────────────────────────────────
AI_ENABLED=true
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=100
AI_MAX_MESSAGES_PER_SESSION=15
AI_MAX_MESSAGES_PER_IP_PER_DAY=30
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=700
AI_USE_PROMPT_CACHING=true
AI_PROMPT_CACHE_TTL=1h
AI_DEGRADE_AT_BUDGET_FRACTION=0.8
ANTHROPIC_SIMPLE_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_REASONING_MODEL=claude-sonnet-4-6
ANTHROPIC_VERSION=2023-06-01
# Semantic layer (pgvector). Dimension must match the vector(N) columns.
AI_EMBEDDING_PROVIDER=          # openai | voyage (leave blank to disable the semantic layer)
AI_EMBEDDING_MODEL=             # e.g. text-embedding-3-small (openai) or voyage-3 (voyage)
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_DIMENSIONS=1536    # must match the vector(N) columns; voyage-3 = 1024
AI_SEMANTIC_CACHE_THRESHOLD=0.92
# Abuse protection (CGNAT-aware) — Turnstile is the primary control.
TURNSTILE_SECRET_KEY=
# WhatsApp Business Cloud API (Phase 2 two-way upgrade; optional now).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Privacy: purge anonymous conversations after N days.
AI_DATA_RETENTION_DAYS=90
